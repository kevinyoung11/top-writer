{
  "name": "wordflow",
  "private": false,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "build:github": "tsc && vite build --mode github",
    "deploy:github": "pnpm run build:github && pnpm gh-pages -m \"Deploy $(git log '--format=format:%H' main -1)\" -d ./dist",
    "deploy:vercel": "pnpm run build && cp -r .vercel ./dist/ && vercel ./dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@floating-ui/dom": "^1.6.3",
    "@mlc-ai/web-llm": "0.2.32",
    "@playwright/test": "^1.61.1",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-bubble-menu": "^3.27.3",
    "@tiptap/extension-document": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-paragraph": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-text": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@types/d3-array": "^3.2.1",
    "@types/d3-format": "^3.0.4",
    "@types/d3-random": "^3.0.3",
    "@types/d3-time-format": "^4.0.3",
    "@types/diff": "^5.0.9",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/emoji-regex": "^9.2.0",
    "@types/node": "^22.20.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@webgpu/types": "^0.1.40",
    "@xiaohk/utils": "^0.0.6",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.0",
    "d3-random": "^3.0.1",
    "d3-time-format": "^4.1.0",
    "diff": "^5.2.0",
    "diff-match-patch": "^1.0.5",
    "emoji-regex": "^10.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.11.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-wc": "^2.0.4",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.1.1",
    "idb-keyval": "^6.2.1",
    "jsdom": "^26.1.0",
    "picomatch": "^4.0.5",
    "prettier": "^3.2.5",
    "tippy.js": "^6.3.7",
    "typescript": "^5.4.4",
    "uuid": "^9.0.1",
    "vite": "^5.2.8",
    "vite-plugin-dts": "^3.8.1",
    "vite-plugin-web-components-hmr": "^0.1.3",
    "vitest": "^3.2.7"
  }
}
